OSL_LOCALIZATION_CONFIG_PATH=./config/localization_video_dali.standalone.yaml
OSL_LOCALIZATION_WEIGHTS=OpenSportsLab/OSL-loc-snbas-2025-e2e

OSL_VQA_QWEN3_MODEL_ENABLED=true
