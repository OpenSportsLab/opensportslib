OSL_SERVER_HOST=0.0.0.0
OSL_SERVER_PORT=8000
OSL_REDIS_URL=redis://127.0.0.1:6379/0
OSL_QUEUE_NAME=osl_inference
OSL_RUNTIME_DIR=./runtime
OSL_LOG_LEVEL=INFO
OSL_WORKER_EXECUTION_MODE=simple
OSL_SESSION_TTL_SECONDS=1800
OSL_WORKER_IDLE_UNLOAD_SECONDS=600
OSL_WORKER_HEARTBEAT_TTL_SECONDS=30
OSL_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
OSL_WORKER_NAME=osl-worker-1
OSL_JOB_TIMEOUT_SECONDS=7200
OSL_MODEL_ROOT=./models
OSL_MODEL_ADMIN_TOKEN=abcdefghijklmnopqrstuvwxyz123456
OSL_MODEL_OPERATION_TIMEOUT_SECONDS=7200
OSL_PREDOWNLOAD_ON_START=false
OSL_HF_CACHE_DIR=
OSL_DOCKER_VQA_DEP_PROFILE=qwen
OSL_DOCKER_PREDOWNLOAD_ON_START=false
OSL_DOCKER_PREDOWNLOAD_WORKER_ONLY=true
HOST_HF_CACHE=./runtime/huggingface-cache

OSL_CLASSIFICATION_MODEL_ENABLED=true
OSL_CLASSIFICATION_MODEL_ID=OpenSportsLab/OSL-cls-action-mvitv2
OSL_CLASSIFICATION_CONFIG_PATH=./config/classification_video.standalone.yaml
OSL_CLASSIFICATION_WEIGHTS=OpenSportsLab/OSL-cls-action-mvitv2

OSL_LOCALIZATION_MODEL_ENABLED=true
